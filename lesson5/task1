module counter (input wire clk,
                input wire rst,
                input wire load,
                input wire [3:0] data_in,
                input wire en,
                input wire up_down,
                output reg [3:0] count);
  
  always_ff @(posedge clk, posedge rst) 
    begin: RESET
      if(rst)
        count <= '0;
      else if(load)
        count <= data_in;
      else if(en)
        if(up_down)
          count <= count + 4'd1;
        else
          count <= count - 4'd1;
      else
        count <= count;
    end
  
endmodule
